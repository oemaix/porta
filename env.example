# Copy this file to .env and fill it in. .env is gitignored.
# Spotify issues the client id and the client secret. This repo cannot generate them.
# The image reads .env at compile time. Do not commit .env.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Name shown in the Spotify app. Not a key.
PORTA_DEVICE_NAME=porta

# Bench networks, tried in order. Leave an unused pair empty.
WIFI_SSID=
WIFI_PASSPHRASE=
WIFI_SSID_2=
WIFI_PASSPHRASE_2=
WIFI_SSID_3=
WIFI_PASSPHRASE_3=
